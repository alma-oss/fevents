framework: net10.0
storage none

source https://api.nuget.org/v3/index.json
nuget FSharp.Core ~> 10.0
nuget FSharp.Data ~> 6.0
nuget NJsonSchema ~> 11.0
nuget CloudNative.CloudEvents ~> 2.8
nuget CloudNative.CloudEvents.NewtonsoftJson ~> 2.8

nuget Feather.ErrorHandling ~> 2.0
nuget Alma.Kafka ~> 30.2
nuget Alma.Serializer ~> 9.0
nuget Alma.EnvironmentModel ~> 10.1

// [ TESTS GROUP ]
group Tests
    source https://api.nuget.org/v3/index.json
    nuget Expecto
    nuget YoloDev.Expecto.TestSdk

// [ FAKE GROUP ]
group Build
    storage none
    source https://api.nuget.org/v3/index.json
    nuget Alma.Build ~> 3.0
